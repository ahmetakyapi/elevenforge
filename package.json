{
  "name": "elevenforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DATABASE_URL= next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reseed-squads": "tsx scripts/reseed-squads.ts",
    "db:reset": "node -e \"require('fs').rmSync('./data/pgdata',{recursive:true,force:true})\" && DATABASE_URL= npm run db:migrate && DATABASE_URL= npm run db:seed",
    "cron:dev": "DATABASE_URL= tsx scripts/cron-dev.ts",
    "db:status": "tsx scripts/db-status.ts",
    "test:season": "DATABASE_URL= tsx scripts/test-full-season.ts",
    "test:multi": "DATABASE_URL= tsx scripts/test-multiplayer.ts",
    "test:ai": "DATABASE_URL= tsx scripts/test-ai-managers.ts",
    "test:longevity": "DATABASE_URL= tsx scripts/test-longevity.ts",
    "test:all": "npm run db:reset && npm run test:ai && npm run test:multi && npm run test:exploits && npm run test:longevity",
    "test:exploits": "DATABASE_URL= tsx scripts/test-exploits.ts",
    "build:squads": "tsx scripts/build-squad-packs.ts",
    "dev:remote": "next dev",
    "db:reprice": "tsx scripts/reprice-players.ts",
    "db:repair-leagues": "tsx scripts/repair-empty-leagues.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
